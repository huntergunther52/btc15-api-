{
  "name": "btc15-api",
  "main": "worker-v450.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "PRICE_HISTORY", "class_name": "PriceHistory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PriceHistory"] }
  ]
}
